<Window x:Class="SolutionBundler.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SolutionBundler.Wpf"
        Title="Solution Bundler" Width="1240" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        FontFamily="./Assets/#Vazirmatn">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1677D2" Geometry="M 2,5 L 9,5 11,8 22,8 22,20 2,20 Z"/>
                    <GeometryDrawing Brush="#7CC4FF" Geometry="M 2,8 L 22,8 20,21 4,21 Z"/>
                    <GeometryDrawing Brush="White" Geometry="M 7,11 L 17,11 17,13 7,13 Z M 7,15 L 15,15 15,17 7,17 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <HierarchicalDataTemplate DataType="{x:Type local:ProjectNode}" ItemsSource="{Binding Children}">
            <Grid FlowDirection="LeftToRight" Margin="2" MinHeight="24" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="2"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                           Margin="5,0,0,0" ToolTip="{Binding Path}"/>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:SchemaNode}" ItemsSource="{Binding Tables}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="2">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,7,0"/>
                <TextBlock Text="▦" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type local:TableNode}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="2">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,7,0"/>
                <TextBlock Text="▤" Opacity="0.72" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0A808080" BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0" FlowDirection="RightToLeft">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="8,10,8,22">
                    <TextBlock Text="Solution Bundler" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                    <TextBlock Text="Developer context exporter" Style="{StaticResource MutedText}" FontSize="11" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton GroupName="Navigation" IsChecked="True" Style="{StaticResource NavButton}"
                                 Checked="Navigation_Checked" Tag="0" Content="📄  فایل‌ها"/>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="Navigation_Checked" Tag="1" Content="▦  SQL Server"/>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="Navigation_Checked" Tag="2" Content="◆  Redis"/>
                </StackPanel>
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="خروجی" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SidebarSelectionSummary" Text="هنوز انتخابی انجام نشده" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Files page -->
            <ScrollViewer x:Name="FilesPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24" MaxWidth="1400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="360"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="فایل‌های Solution" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="پروژه‌ها، پوشه‌ها و پسوندهای موردنیاز را انتخاب کنید." Style="{StaticResource MutedText}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="مسیر Solution" FontWeight="SemiBold"/>
                                <TextBox x:Name="RootPathBox" Margin="0,7,0,0" FlowDirection="LeftToRight" IsReadOnly="True"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="انتخاب پوشه" Margin="12,22,0,0" Padding="18,8" Click="BrowseRoot_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="پروژه‌ها و پوشه‌ها" Style="{StaticResource SectionTitle}" DockPanel.Dock="Right"/>
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                        <Button Content="★" ToolTip="افزودن Favorite" Click="AddFavorite_Click"/>
                                        <Button Content="☆" ToolTip="حذف Favorite" Margin="6,0,0,0" Click="RemoveFavorite_Click"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Grid.Row="1" x:Name="ProjectSearchBox" Margin="0,0,0,10"
                                         ToolTip="جست‌وجوی پروژه یا پوشه" TextChanged="ProjectSearchBox_TextChanged"/>
                                <TreeView Grid.Row="2" x:Name="ProjectTree" ItemsSource="{Binding ProjectRoots}"
                                          FlowDirection="LeftToRight" SelectedItemChanged="ProjectTree_SelectedItemChanged"
                                          Height="430" MinHeight="300" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.PanningMode="VerticalFirst"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          PreviewMouseWheel="NestedScroll_PreviewMouseWheel"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="پسوندها" Style="{StaticResource SectionTitle}"/>
                                    <Button Content="اسکن" HorizontalAlignment="Left" Padding="16,6" Click="ScanExtensions_Click"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="انتخاب همه" Click="SelectAllExtensions_Click"/>
                                    <Button Content="لغو همه" Margin="7,0,0,0" Click="ClearExtensions_Click"/>
                                </StackPanel>
                                <ListBox Grid.Row="2" x:Name="ExtensionList" ItemsSource="{Binding Extensions}"
                                         Height="430" MinHeight="300" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="3">
                                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                    <TextBlock Text="{Binding Name}" Width="90" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Count, StringFormat={}{0:N0} files}" Opacity="0.62"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="فایل خروجی" FontWeight="SemiBold"/>
                                <TextBox x:Name="OutputPathBox" Margin="0,7,0,0" FlowDirection="LeftToRight"/>
                                <TextBlock x:Name="EstimateText" Text="Estimated output: —" FlowDirection="LeftToRight" Margin="0,7,0,0" Opacity="0.72"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="تغییر مسیر" Margin="12,22,0,0" Click="BrowseOutput_Click"/>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0" FlowDirection="LeftToRight">
                                <Button x:Name="GenerateButton" Content="تولید فایل" Padding="24,9" Click="Generate_Click"/>
                                <Button x:Name="CancelButton" Content="لغو" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                                <Button x:Name="OpenOutputButton" Content="باز کردن فایل" Margin="8,0,0,0" IsEnabled="False" Click="OpenOutput_Click"/>
                                <Button x:Name="OpenFolderButton" Content="باز کردن پوشه" Margin="8,0,0,0" IsEnabled="False" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- SQL page -->
            <ScrollViewer x:Name="SqlPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="1100">
                    <TextBlock Text="SQL Server" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Connection String را پیدا کنید، Schema و جدول‌ها را انتخاب کنید." Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Connection" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="SqlConnectionCombo" DisplayMemberPath="DisplayName" SelectionChanged="SqlConnectionCombo_SelectionChanged"/>
                            <TextBox x:Name="SqlConnectionBox" Margin="0,8,0,0" FlowDirection="LeftToRight"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="یافتن Connectionها" Click="DiscoverSql_Click"/>
                                <Button Content="اتصال و دریافت جداول" Margin="8,0,0,0" Click="LoadSqlTables_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="360"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Schema و Table" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="انتخاب همه" Click="SelectAllTables_Click"/>
                                    <Button Content="لغو همه" Margin="7,0,0,0" Click="ClearTables_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <TreeView Grid.Row="1" ItemsSource="{Binding Schemas}" FlowDirection="LeftToRight" BorderThickness="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      PreviewMouseWheel="NestedScroll_PreviewMouseWheel"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="تعداد رکورد اول هر جدول:" VerticalAlignment="Center"/>
                                <TextBox x:Name="SqlRowLimitBox" Text="100" Width="100" Margin="8,0" FlowDirection="LeftToRight"/>
                                <CheckBox x:Name="IncludeSqlCheck" Content="افزودن به خروجی" IsChecked="True" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Redis page -->
            <ScrollViewer x:Name="RedisPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="1000">
                    <TextBlock Text="Redis" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="کلیدها و مقدارهای Redis را با محدودیت کنترل‌شده به خروجی اضافه کنید." Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Connection" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="RedisConnectionCombo" DisplayMemberPath="DisplayName" SelectionChanged="RedisConnectionCombo_SelectionChanged"/>
                            <TextBox x:Name="RedisConnectionBox" Margin="0,8,0,12" FlowDirection="LeftToRight"/>
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <StackPanel Margin="4"><TextBlock Text="Database"/><TextBox x:Name="RedisDbBox" Text="0" FlowDirection="LeftToRight"/></StackPanel>
                                <StackPanel Margin="4"><TextBlock Text="Key pattern"/><TextBox x:Name="RedisPatternBox" Text="*" FlowDirection="LeftToRight"/></StackPanel>
                                <StackPanel Margin="4"><TextBlock Text="حداکثر کلید"/><TextBox x:Name="RedisKeyLimitBox" Text="100" FlowDirection="LeftToRight"/></StackPanel>
                                <StackPanel Margin="4"><TextBlock Text="حداکثر اعضا"/><TextBox x:Name="RedisMemberLimitBox" Text="100" FlowDirection="LeftToRight"/></StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="یافتن Connectionها" Click="DiscoverRedis_Click"/>
                                <Button Content="Test Connection" Margin="8,0,0,0" Click="TestRedis_Click"/>
                                <CheckBox x:Name="IncludeRedisCheck" Content="افزودن به خروجی" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="18,10" Background="#08808080">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="آماده" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="BusyProgress" Grid.Column="1" Width="180" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
